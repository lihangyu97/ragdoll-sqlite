{
  "name": "ragdoll-sqlite",
  "version": "0.1.0",
  "description": "命令行工具：启动本地网页，只读浏览 SQLite 数据库",
  "type": "module",
  "bin": {
    "ragdoll-sqlite": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "pnpm run build:server && pnpm run build:web",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "start": "node dist/cli.js",
    "dev:web": "vite dev",
    "dev:server": "tsc -p tsconfig.server.json && node dist/cli.js --dev"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
