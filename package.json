{
  "name": "ragdoll-sqlite",
  "version": "0.1.0",
  "description": "命令行工具：启动本地网页，只读浏览 SQLite 数据库（数据库路径可选，启动后在主页选择）",
  "type": "module",
  "bin": {
    "ragdoll-sqlite": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "sqlite3",
    "database",
    "viewer",
    "browser",
    "readonly",
    "cli",
    "sql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihangyu97/ragdoll-sqlite.git"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "pnpm run build:server && pnpm run build:web",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\" && vitest run",
    "start": "node dist/cli.js",
    "dev:web": "vite dev",
    "dev:server": "tsc -p tsconfig.server.json && node dist/cli.js --dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm run build",
    "pack": "npm pack"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@uiw/react-codemirror": "^4.25.11",
    "antd": "^6.6.1",
    "better-sqlite3": "^13.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
